{
  "expo": {
    "name": "Expense Tracker",
    "slug": "finance-tracker",
    "scheme": "financetracker",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./src/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.patrickackom.financetracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.patrickackom.financetracker",
      "adaptiveIcon": {
        "foregroundImage": "./src/icon.png",
        "backgroundColor": "#BFAAF5"
      }
    },
    "splash": {
      "image": "./src/icon.png",
      "backgroundColor": "#BFAAF5",
      "resizeMode": "contain"
    },
    "extra": {
      "eas": {
        "projectId": "5f343e27-5b81-42fc-8220-302ce8233661"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-secure-store",
      "expo-font"
    ],
    "notification": {
      "icon": "./src/icon.png",
      "color": "#6366F1"
    }
  }
}
